INSTALLDIR = $(HOME)/.local
UNAME_S    = $(shell uname -s)
UNAME_M    = $(shell uname -m)
ifeq ($(UNAME_S),Darwin)
    NVIM_OS = macos
else
    NVIM_OS = linux
endif
ifeq ($(UNAME_M),aarch64)
    ARCH = arm64
else
    ARCH = $(UNAME_M)
endif
NVIM_URL   = https://github.com/neovim/neovim/releases/latest/download/nvim-$(NVIM_OS)-$(ARCH).tar.gz

.PHONY: info nvim

info:
	@echo "make nvim       install latest Nvim to $(INSTALLDIR)"

nvim:
	mkdir -p $(INSTALLDIR)
	curl -fsSL $(NVIM_URL) | tar -xzf - -C $(INSTALLDIR) --strip-components=1
